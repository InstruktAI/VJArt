    "doc": "docs"
  },
  "scripts": {
    "dev": "concurrently -n bridge,web -c blue,magenta \"npm run dev -w packages/bridge\" \"npm run dev -w apps/web\"",
    "dev:bridge": "npm run dev -w packages/bridge",
    "dev:web": "npm run dev -w apps/web",
    "test": "npm test --workspaces",
